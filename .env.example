# ==============================================================================
# BuildMart Monorepo — Unified Environment Configuration Template
# ==============================================================================
# Copy this file to .env at root and inside individual app folders as needed.
# SECURITY NOTICE: NEVER commit real .env files with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=buildmart_user
POSTGRES_PASSWORD=buildmart_secure_pass
POSTGRES_DB=buildmart
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://buildmart_user:buildmart_secure_pass@localhost:5432/buildmart
DATABASE_SYNC_URL=postgresql+psycopg2://buildmart_user:buildmart_secure_pass@localhost:5432/buildmart

# ------------------------------------------------------------------------------
# 2. Redis 7 (Cache & Task Queue)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Python FastAPI Backend (services/api)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Next.js Frontend (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-change-in-production-min-32-chars

# ------------------------------------------------------------------------------
# 5. Payments (Razorpay)
# ------------------------------------------------------------------------------
# Public key for clients (Next.js & Flutter)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_TM6Z7BqbHQaK7R
RAZORPAY_KEY_ID=rzp_test_TM6Z7BqbHQaK7R
# Server-only secret keys (services/api)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. Cloudinary CDN (Image storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=snwiu5gv
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 7. Maps & Geolocation
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 8. Firebase Auth & Admin
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=buildmart-prod
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
