{
  "name": "buildmart-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "pytest tests/e2e/test_playwright_e2e.py -v",
    "typecheck": "turbo typecheck",
    "dev:web": "pnpm --filter @buildmart/web dev",
    "dev:api": "pnpm --filter @buildmart/api dev",
    "build:web": "pnpm --filter @buildmart/web build",
    "clean": "turbo clean"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
