# ==============================================================================
# BuildMart Android Release Signing Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Generate an upload/release keystore:
#    keytool -genkey -v -keystore buildmart-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias buildmart_upload
# 2. Copy this file to mobile/android/key.properties:
#    cp key.properties.example key.properties
# 3. Fill in your actual keystore credentials.
# 4. NEVER commit key.properties or .jks files to version control.
# ==============================================================================

storePassword=your_keystore_password_here
keyPassword=your_key_password_here
keyAlias=buildmart_upload
storeFile=../buildmart-release.jks
