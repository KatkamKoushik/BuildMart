# ==============================================================================
# BuildMart Mobile & Web Application - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this template to .env at the project root for local development:
#   Linux/macOS : cp .env.example .env
#   Windows PS  : Copy-Item .env.example .env
#
# SECURITY NOTICE:
# - NEVER commit the real .env file or any private credentials to version control.
# - NEVER bundle privileged server secrets (e.g. database master passwords,
#   Firebase Admin SDK private keys, payment secret keys) into mobile apps.
# ==============================================================================

# Razorpay Client-Side Key ID (Public Key)
# Note: DO NOT put RAZORPAY_KEY_SECRET here. Secret keys belong exclusively on secure servers.
RAZORPAY_KEY_ID=rzp_test_TM6Z7BqbHQaK7R

# Google Maps API Key (Optional client key for Maps & Geolocation services)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# Developer Offline Tooling Credentials (Used ONLY by scripts in scripts/ / tool/)
# These keys are NEVER accessed or packaged by the Flutter mobile client runtime.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
