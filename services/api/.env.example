# BuildMart FastAPI Service Environment Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="BuildMart API"
VERSION="2.0.0"
API_V1_PREFIX=/api/v1
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars

# Database Connection (PostgreSQL with asyncpg or SQLite with aiosqlite for local testing)
DATABASE_URL=sqlite+aiosqlite:///./buildmart.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://buildmart_user:buildmart_secure_pass@localhost:5432/buildmart

# Redis Cache & Queues
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Razorpay Integration (Live credentials required in production)
RAZORPAY_KEY_ID=rzp_test_TM6Z7BqbHQaK7R
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_mock_webhook

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=snwiu5gv
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
